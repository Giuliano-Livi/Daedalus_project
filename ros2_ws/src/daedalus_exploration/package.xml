<?xml version="1.0"?>
<package format="3">
  <name>daedalus_exploration</name>
  <version>0.0.1</version>
  <description>Autonomous exploration of the warehouse (AEP: receding-horizon NBV + frontier caching) on a 3D OctoMap</description>
  <maintainer email="giuliano@example.com">giuliano</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>eigen</depend>
  <!-- 3D map: liboctomap (system); RTAB-Map graph (keyframe poses) for the redraws -->
  <depend>liboctomap-dev</depend>
  <depend>rtabmap_msgs</depend>
  <!-- FlightSetpoint for offboard_control -->
  <depend>daedalus_interfaces</depend>
  <!-- launch files -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>daedalus_slam</exec_depend>
  <exec_depend>daedalus_trajectories</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
