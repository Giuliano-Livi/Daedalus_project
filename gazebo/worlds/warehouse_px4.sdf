<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="warehouse_px4">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
      <grid>true</grid>
      <!-- indoor: lit by the roof lamps (point lights in the generated block), low ambient for the
           light bounced around; shadows stay off (frame rate) -->
      <ambient>0.22 0.22 0.22 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-3.90827 -4.65526 12 0 0.9 0.728194</pose>
        <view_controller>fps</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 70</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode />
            </friction>
            <bounce />
            <contact />
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 70</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <!-- with shadows off the roof cannot block the sun: kept faint, as daylight from the skylights -->
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>0.2</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- BEGIN draft layout (generated by scripts/gen_warehouse_layout.py, do not edit by hand) -->
    <!-- Walls: 70 x 30 m outer, 1 m thick, 9 m high, textured inner faces -->
    <model name="warehouse_walls">
      <include>
        <uri>model://warehouse_walls</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Floor: textured concrete + lane markings (visual only, collision = ground_plane) -->
    <model name="warehouse_floor">
      <include>
        <uri>model://warehouse_floor</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Roof at 9 m: deck, beams, purlins -->
    <model name="warehouse_roof">
      <include>
        <uri>model://warehouse_roof</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Lighting: 48 LED fixtures + 20 point lights, one model -->
    <model name="warehouse_lights">
      <include>
        <uri>model://warehouse_lights</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Shelf lines 1-3 (shelves + pallets merged per line) and zone 4 (pallets + boxes) -->
    <model name="shelf_line_1">
      <include>
        <uri>model://warehouse_line_1</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>
    <model name="shelf_line_2">
      <include>
        <uri>model://warehouse_line_2</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>
    <model name="shelf_line_3">
      <include>
        <uri>model://warehouse_line_3</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>
    <model name="pallet_zone_4">
      <include>
        <uri>model://warehouse_zone_4</uri>
      </include>
      <pose>0 0 0 0 0 0</pose>
    </model>
    <!-- END draft layout -->

    <!-- Extra models placed by hand go here, outside the generated block.
         Free pallets: rows of gazebo/worlds/pallet_slots.csv with an empty "box" column,
         a model with its origin at the bottom center goes at x y z_top. -->

    <!-- The floor is warehouse_floor, in the generated block above (it replaced the AWS
         aws_robomaker_warehouse_GroundB_01 mesh: light low-contrast concrete tiled every ~4-9 m,
         with markings of another layout) -->

  </world>
</sdf>